{
  "name": "@comp5565/contracts",
  "version": "0.1.0",
  "private": true,
  "description": "Hardhat 3 workspace: Solidity contracts for product provenance and warranty management",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "compile": "hardhat compile",
    "test": "hardhat test",
    "coverage": "hardhat test --coverage",
    "node": "hardhat node",
    "clean": "hardhat clean",
    "typecheck": "hardhat compile && tsc --noEmit",
    "export:abi": "hardhat run scripts/export-abi.ts",
    "deploy:local": "hardhat run scripts/deploy.ts --network localhost",
    "deploy:sepolia": "hardhat run scripts/deploy.ts --network sepolia",
    "seed:local": "hardhat run scripts/seed-demo.ts --network localhost"
  },
  "dependencies": {
    "@openzeppelin/contracts": "^5.6.1"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-ethers": "^4.2.1",
    "@nomicfoundation/hardhat-ethers-chai-matchers": "^3.0.0",
    "@nomicfoundation/hardhat-ignition": "^3.1.9",
    "@nomicfoundation/hardhat-ignition-ethers": "^3.1.6",
    "@nomicfoundation/hardhat-keystore": "^3.1.2",
    "@nomicfoundation/hardhat-mocha": "^4.0.1",
    "@nomicfoundation/hardhat-network-helpers": "^3.0.12",
    "@nomicfoundation/hardhat-toolbox-mocha-ethers": "^4.0.0",
    "@nomicfoundation/hardhat-typechain": "^3.1.3",
    "@nomicfoundation/hardhat-verify": "^3.1.4",
    "@nomicfoundation/ignition-core": "^3.1.11",
    "@types/chai": "^5.2.3",
    "@types/chai-as-promised": "^8.0.1",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.20.5",
    "chai": "^6.2.2",
    "dotenv": "^17.2.3",
    "ethers": "^6.17.0",
    "hardhat": "^3.21.0",
    "mocha": "^12.0.3",
    "typescript": "~6.0.3"
  }
}
